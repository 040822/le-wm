{
  "schema_version": 1,
  "experiment": "R4-Reacher-step-diagnosis",
  "description": "Fixed-context Euler/Heun and batch-one CEM diagnostics for the R4-AB Reacher step sensitivity.",
  "protocol": "round3_revised",
  "training": {
    "model": "R4-AB",
    "seed": 3072,
    "checkpoint_epoch": 10,
    "retrain": false
  },
  "task": "reacher",
  "cohort": {
    "kind": "dev",
    "episodes": 50,
    "seed": 42,
    "goal_offset_steps": 25,
    "source": "outputs/round3/phase1/cohorts/reacher/dev_round3_revised.json"
  },
  "sampler": {
    "integrators": {
      "euler": [1, 2, 4, 5, 8, 10, 16, 32],
      "heun": [4, 8, 16, 32]
    },
    "noise_seed": 3072,
    "same_noise_across_variants": true
  },
  "cem": {
    "enabled": true,
    "solver_seed": 42,
    "solver_batch_size": 1,
    "num_samples": 300,
    "topk": 30,
    "iterations": 30,
    "var_scale": 1.0,
    "variants": [
      "p1_no_warm",
      "p2_euler_1",
      "p2_euler_16",
      "p2_euler_32",
      "p2_euler_16_alpha_0.5",
      "p2_euler_16_alpha_0.75"
    ]
  },
  "closed_loop_gate": {
    "required": ["p2_euler_32"],
    "scaled_alpha_out_of_range_tolerance_pp": 2.0,
    "heun_path_difference_threshold": 0.05,
    "heun_out_of_range_delta_threshold_pp": 5.0,
    "new_final_evaluation": false
  },
  "output_root": "outputs/round4/reacher_step_diagnosis_seed3072_dev",
  "gpu_policy": "Only physical GPU0, GPU1, GPU2, and GPU3 may be used; every CUDA command sets CUDA_VISIBLE_DEVICES explicitly."
}
